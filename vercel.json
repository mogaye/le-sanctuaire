{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/diagnostics",
      "destination": "/api/accounts?action=diagnostics"
    },
    {
      "source": "/api/accounts/sync",
      "destination": "/api/accounts?action=sync"
    },
    {
      "source": "/api/auth/send-code",
      "destination": "/api/auth?action=send-code"
    },
    {
      "source": "/api/auth/verify-code",
      "destination": "/api/auth?action=verify-code"
    },
    {
      "source": "/api/donations/check",
      "destination": "/api/donations?action=check"
    },
    {
      "source": "/api/donations/thank-you",
      "destination": "/api/donations?action=thank-you"
    },
    {
      "source": "/api/emails/log",
      "destination": "/api/emails?action=log"
    },
    {
      "source": "/api/prayers/:userId/:date",
      "destination": "/api/prayers?userId=:userId&date=:date"
    },
    {
      "source": "/api/users/me",
      "destination": "/api/accounts?action=me"
    },
    {
      "source": "/api/subscription/status",
      "destination": "/api/subscription?action=status"
    },
    {
      "source": "/api/subscription/record-video",
      "destination": "/api/subscription?action=record-video"
    },
    {
      "source": "/api/subscription/upgrade",
      "destination": "/api/subscription?action=upgrade"
    },
    {
      "source": "/api/analytics/heartbeat",
      "destination": "/api/admin?action=heartbeat"
    },
    {
      "source": "/api/reports",
      "destination": "/api/admin?action=reports"
    },
    {
      "source": "/api/reports/:id",
      "destination": "/api/admin?action=update-report&id=:id"
    },
    {
      "source": "/api/admin/overview",
      "destination": "/api/admin?action=overview"
    },
    {
      "source": "/api/admin/users",
      "destination": "/api/admin?action=users"
    },
    {
      "source": "/api/admin/users/:email/plan",
      "destination": "/api/admin?action=set-plan&targetEmail=:email"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|images/|assets/|contact\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
